<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>>@ViewBag.Title - CadUser</title>
    <link rel="stylesheet" href="~/Resources/Layout/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/Resources/Layout/dist/css/adminlte.css">
    <link rel="stylesheet" href="~/Resources/Layout/plugins/toastr/toastr.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="wrapper">
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="#" class="nav-link"><b>Inicio</b></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="#" class="nav-link"><b>Sobre</b></a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <div class="navbar-search-block">
                        <form class="form-inline">
                            <div class="input-group input-group-sm">
                                <input class="form-control form-control-navbar" type="search" placeholder="Search" aria-label="Search">
                                <div class="input-group-append">
                                    <button class="btn btn-navbar" type="submit">
                                        <i class="fas fa-search"></i>
                                    </button>
                                    <button class="btn btn-navbar" type="button" data-widget="navbar-search">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
            </ul>
        </nav>
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="#l" class="brand-link">
                <i class="fas fa-cubes"></i>&nbsp;&nbsp;
                <span class="brand-text font-weight-light"><strong>Cad</strong>Usuários</span>
            </a>
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <p class="nav-link">
                                <i class="fas fa-user-tie nav-icon"></i>
                                @Html.ActionLink("Usuários", "Index", "Usuario")
                            </p>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>
        <div class="content-wrapper">
            <div class="content">
                @RenderBody()
            </div>
        </div>
        <footer class="main-footer">
            <div class="float-right d-none d-sm-inline">
                Desenvolvido por Rômulo Ribeiro
            </div>
            <strong>Copyright &copy; 2021 <a href="https://www.linkedin.com/in/r%C3%B4mulo-ribeiro-da-silva-3b266627/">Linkedin</a>.</strong> Todos os direitos reservados
        </footer>
    </div>
    <script src="~/Resources/Layout/plugins/jquery/jquery.js"></script>
    <script src="~/Resources/Layout/plugins/jquery/jquery.min.js"></script>
    <script src="~/Resources/Layout/plugins/bootstrap/js/bootstrap.js"></script>
    <script src="~/Resources/Layout/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/adminlte.min.js"></script>
    <script src="~/Resources/Layout/dist/js/adminlte.min.js"></script>
    <script src="~/Resources/Layout/plugins/toastr/toastr.min.js"></script>
    @RenderSection("ScriptPage", required: false)
</body>
</html>