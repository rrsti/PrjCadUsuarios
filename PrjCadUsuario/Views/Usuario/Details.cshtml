@model PrjCadUsuario.Models.Usuario

@{
    ViewBag.Title = "Details";
    Layout = null;
}
<div>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <!-- Main content -->
                    <div class="invoice p-3 mb-3">
                        <!-- title row -->
                        <div class="row">
                            <div class="col-12">
                                <h4><i class="fas fa-address-book"></i>&nbsp;&nbsp;@Html.DisplayFor(model => model.Nome)</h4>
                                <b>Registro:</b>&nbsp;@Html.DisplayFor(model => model.UsuarioId)&nbsp;
                                <b>Login:</b>&nbsp;@Html.DisplayFor(model => model.Login)&nbsp;
                                <b>Ativo:</b>@Html.DisplayFor(model => model.Ativo)
                            </div>
                            <!-- /.col -->
                        </div>
                        <br />
                        <!-- info row -->
                        <div class="row invoice-info">
                            <div class="col-sm-4 invoice-col">
                                <b>Contatos</b><br>
                                <br>
                                <b>Telefone:</b>@Html.DisplayFor(model => model.Telefone)<br>
                                <b>E-mail:</b>@Html.DisplayFor(model => model.Email)<br>
                            </div>
                            <br />
                            <div class="col-sm-4 invoice-col">

                            </div>
                            <!-- /.col -->
                        </div>
                        <!-- /.row -->
                        <!-- Table row -->
                        <!-- /.row -->
                        <!-- this row will not appear when printing -->
                        <div class="row no-print">
                            <div class="col-12">
                                @Html.ActionLink("Atualizar dados", "Edit", new { id = Model.UsuarioId, @class = "btn btn-primary" })
                            </div>
                        </div>
                    </div>
                    <!-- /.invoice -->
                </div><!-- /.col -->
            </div><!-- /.row -->
        </div><!-- /.container-fluid -->
    </section>
</div>
