@model IEnumerable<PrjCadUsuario.Models.Usuario>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/lib/datatables/css/jquery.dataTables.min.css" />
        <link rel="stylesheet" href="~/resources/layout/plugins/datatable/datatables-bs4/css/dataTables.bootstrap4.min.css" />
        <link rel="stylesheet" href="~/resources/layout/plugins/datatable/datatables-responsive/css/responsive.bootstrap4.min.css" />
        <link rel="stylesheet" href="~/resources/layout/plugins/datatable/datatables-buttons/css/buttons.bootstrap4.min.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="https://cdn.datatables.net/1.10.20/css/jquery.dataTables.min.css" asp-fallback-href="~/lib/datatables/css/jquery.data" asp-fallback-test-class="sr-only" asp-fallback-test-property="position" asp-fallback-test-value="absolute" />
    </environment>
}
<br />
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    if (@TempData["MsgSucesso"] != null)
    {
        <div class="row">
            <div class="col-md-12">
                <div class="alert alert-success alert-dismissible">
                    <span aria-hidden="true">@TempData["MsgSucesso"]</span>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
        </div>
    }
    <section class="content">
        <div class="container-fluid">
            <div class="card card-secondary">
                <div class="card-header">
                    <h3 class="card-title">Usuários cadastrados no sistema</h3>
                </div>
                <!-- /.card-header -->
                <div class="card-body">
                    <form asp-controller="Hospital" asp-action="Index">
                        <p>@Html.ActionLink("Incluir novo", "Create")</p>
                        <table id="tblPesquisa" class="table table-bordered table-hover" style="width: 100% !important;">
                            <thead>
                                <tr>
                                    <th colspan="3">Pesquisar</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="control-label">Nome</label>
                                    </td>
                                    <td>
                                        <input type="text" name="SearchString" class="form-control" size="100" />
                                    </td>
                                    <td>
                                        <input type="submit" value="Filtrar" class="btn btn-info btn-sm" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <table id="dtblUsuarios" class="table table-bordered table-hover">
                            <tr>
                                <th style="width: 50px !important;">Nome do Usuário</th>
                                <th style="width: 30px !important;">Login</th>
                                <th style="width: 20px !important;">Telefone</th>
                                <th style="width: 50px !important;">E-mail</th>
                                <th style="width: 50px !important; text-align: center !important; "></th>
                            </tr>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="width: 150px !important;">@Html.DisplayFor(model => item.Nome)</td>
                                        <td style="width: 10px !important;">@Html.DisplayFor(model => item.Login)</td>
                                        <td style="width: 10px !important;">@Html.DisplayFor(model => item.Telefone)</td>
                                        <td style="width: 100px !important;">@Html.DisplayFor(model => item.Email)</td>
                                        <td style="width: 50px !important; text-align: center !important;">
                                            <a class="btn btn-primary btn-sm btnDetalhes" data-toggle="modal" data-target="#modalDetails" data-id="@item.UsuarioId">
                                                <i class="fas fa-folder">
                                                </i>
                                            </a>
                                            <a class="btn btn-danger btn-sm btnDelete" data-toggle="modal" data-target="#modalDelete" data-id="@item.UsuarioId">
                                                <i class="fas fa-trash">
                                                </i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </form>
                </div>
            </div>
        </div>
    </section>
}
<div class="modal fade" id="modalDetails" itabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Dados do Usuário</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modal-body">

            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<div class="modal fade" id="modalDelete" itabindex="-1" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Excluir Registro</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modal-body-Delete">

            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

@section ScriptPage {
    <environment include="Development">
        <script src="~/resources/layout/plugins/datatable/datatables/jquery.dataTables.min.js"></script>
        <script src="~/resources/layout/plugins/jquery/jquery.min.js"></script>
        <!-- Bootstrap 4 -->
        <script src="~/resources/layout/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
        <!-- DataTables  & Plugins -->
        <script src="~/resources/layout/plugins/datatable/datatables/jquery.dataTables.min.js"></script>
        <script src="~/resources/layout/plugins/datatable/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
        <script src="~/resources/layout/plugins/datatable/datatables-responsive/js/dataTables.responsive.min.js"></script>
        <script src="~/resources/layout/plugins/datatable/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
        <script src="~/resources/layout/plugins/datatable/datatables-buttons/js/dataTables.buttons.min.js"></script>
        <script src="~/resources/layout/plugins/datatable/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
        <script src="~/resources/layout/plugins/jszip/jszip.min.js"></script>
        <script src="~/resources/layout/plugins/pdfmake/pdfmake.min.js"></script>
        <script src="~/resources/layout/plugins/pdfmake/vfs_fonts.js"></script>
        <script src="~/resources/layout/plugins/datatable/datatables-buttons/js/buttons.html5.min.js"></script>
        <script src="~/resources/layout/plugins/datatable/datatables-buttons/js/buttons.print.min.js"></script>
        <script src="~/resources/layout/plugins/datatable/datatables-buttons/js/buttons.colVis.min.js"></script>
        <script>
            $(function () {
                $('#dtblUsuarios').DataTable({
                    "paging": true,
                    "lengthChange": false,
                    "searching": false,
                    "ordering": true,
                    "info": true,
                    "pageLength": 5,
                    "autoWidth": false,
                    "responsive": true,
                });
            });
            $(function () {
                $.ajaxSetup({ cache: false });
                $(".btnDetalhes").click(function () {
                    var id = $(this).attr("data-id");
                    $("#modal-body").load("/Usuario/Details/" + id, function () {
                        $('#modalDetails').modal("show");
                    });
                });
            });
            $(function () {
                $.ajaxSetup({ cache: false });
                $(".btnDelete").click(function () {
                    var id = $(this).attr("data-id");
                    $("#modal-body-Delete").load("/Usuario/Delete/" + id, function () {
                        $('#modalDelete').modal("show");
                    });
                });
            });
        </script>
    </environment>
}
